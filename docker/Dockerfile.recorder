# The "recorder" image — everything Stage 1 (recording a meeting) and the
# one-time Google/Zoom sign-in need, on the `main` (Alpine) branch.
#
# WHY THIS EXISTS: the host is Alpine Linux (musl libc). Google ships no musl
# build of Chrome, and Playwright does not support Alpine. So the browser half
# of the system runs in this Debian container; transcribe and summarize are
# Python + ffmpeg and run natively on the Alpine host.
#
# The container runs the SAME screen/record_screen.sh as every Linux branch
# (Xvfb display + PulseAudio sink claimed per run by lib/xsession.sh), with
# the repo bind-mounted read-only at /app and the bot's state and recordings
# mounted at their host paths — see docker/recorder_lib.sh. Code changes take
# effect without a rebuild; the image only carries the packages.
#
#   docker build -t meeting-bot-recorder:latest -f docker/Dockerfile.recorder .
#   (./setup.sh --build-recorder does this)
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/root \
    MEETING_BOT_IN_RECORDER=1 \
    MEETING_BOT_VENV=/opt/meeting-bot-venv \
    MEETING_BROWSER=chrome \
    PATH=/opt/meeting-bot-venv/bin:$PATH

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# xvfb / pulseaudio  the per-run display and sink (lib/xsession.sh starts the
#                    PulseAudio daemon on demand — a container has no audio stack)
# x11vnc / novnc     first_time_login.sh --novnc
# ffmpeg             x11grab + pulse -> MP4
# fonts-*            Thai participant names (locale th-TH)
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg tini \
      xvfb x11vnc novnc websockify \
      pulseaudio pulseaudio-utils \
      ffmpeg python3 procps psmisc util-linux locales \
      fonts-thai-tlwg fonts-liberation fonts-noto-core \
 && sed -i 's/^# *\(en_US.UTF-8\|th_TH.UTF-8\)/\1/' /etc/locale.gen && locale-gen >/dev/null \
 && wget -q -O /tmp/google.pub https://dl.google.com/linux/linux_signing_key.pub \
 && gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg /tmp/google.pub && rm -f /tmp/google.pub \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
      > /etc/apt/sources.list.d/google-chrome.list \
 && apt-get update -qq && apt-get install -y --no-install-recommends google-chrome-stable \
 && rm -rf /var/lib/apt/lists/*

# The same hash-pinned glibc lockfiles as the Debian branches: capture.py,
# browser.py and the small helpers record_screen.sh runs need playwright and
# the shared modules' imports.
COPY requirements.txt requirements-browser.txt /tmp/
RUN uv venv --seed --python 3.13 /opt/meeting-bot-venv \
 && uv pip install --quiet --python /opt/meeting-bot-venv/bin/python3 \
      -r /tmp/requirements.txt -r /tmp/requirements-browser.txt \
 && /opt/meeting-bot-venv/bin/playwright install-deps chromium >/dev/null \
 && rm -rf /var/lib/apt/lists/* /root/.cache /tmp/requirements*.txt

RUN google-chrome-stable --version && ffmpeg -version | head -n 1
WORKDIR /app
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
