# The "recorder" image — everything Stage 1 (screen recording) and the
# one-time Google/Zoom login need.
#
# WHY THIS EXISTS: the host is Alpine Linux (musl libc). Google ships no musl
# build of Chrome, and Playwright does not support Alpine for its bundled
# browsers. CLAUDE.md requires real google-chrome-stable (unbranded Chromium
# gets blocked by Google's sign-in flow with "This browser or app may not be
# secure"). So the browser half of the system lives in a Debian container on
# the Alpine host; stages 2 and 3 (transcribe/summarize) are pure
# Python + ffmpeg and run natively on Alpine.
#
# Everything Stage 1 touches is inside this image: Xvfb, PulseAudio, ffmpeg,
# Chrome, Playwright, x11vnc + noVNC. That also gives us per-run isolation
# for free — each container has its own PID/IPC/network namespace, so two
# concurrent recordings can both use display :99 and a sink named
# "meeting_sink" without colliding.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PYTHONUNBUFFERED=1 \
    HOME=/root

# --- System packages --------------------------------------------------------
# xvfb          virtual display :99 (the thing ffmpeg x11grab captures)
# x11vnc+novnc  the viewable-browser path used by first_time_login.sh
# pulseaudio    the meeting_sink null-sink that ffmpeg records from
# ffmpeg        muxes x11grab video + pulse audio into the MP4
# fonts-thai-*  Thai participant names render correctly (locale is th-TH)
# procps/psmisc pkill / fuser, used by the cleanup paths in the shell scripts
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg unzip \
      xvfb x11vnc novnc websockify \
      pulseaudio pulseaudio-utils \
      ffmpeg \
      python3 python3-venv python3-pip \
      procps psmisc wmctrl xdotool \
      locales fonts-thai-tlwg fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Thai locale: Meet's UI is driven with locale th-TH so Thai participant names
# render instead of boxes. See CLAUDE.md — this is deliberate, not cosmetic.
RUN sed -i 's/^# *\(en_US.UTF-8\|th_TH.UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 th_TH.UTF-8

# --- Real Google Chrome -----------------------------------------------------
# NOT chromium. Google's sign-in flow blocks unbranded Chromium builds, which
# is exactly why this container exists in the first place.
RUN wget -q -O /tmp/google-signing-key.pub https://dl.google.com/linux/linux_signing_key.pub \
    && gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg /tmp/google-signing-key.pub \
    && rm -f /tmp/google-signing-key.pub \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
       > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# --- Python venv + Playwright ----------------------------------------------
# Only the join driver's dependency lives here. The transcribe/summarize SDKs
# (assemblyai, anthropic, openai, google-genai) are installed on the Alpine
# host instead — those stages never enter this container.
#
# `playwright install-deps chromium` pulls the shared libraries Chrome needs;
# we deliberately do NOT `playwright install chromium` (the bundled browser),
# because capture.py uses channel="chrome" against the Debian package above.
RUN python3 -m venv /opt/meeting-bot-venv \
    && /opt/meeting-bot-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/meeting-bot-venv/bin/pip install --no-cache-dir playwright \
    && /opt/meeting-bot-venv/bin/playwright install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/meeting-bot-venv/bin:${PATH}"

# Mount points. The repo is bind-mounted at /app and the output root at
# /opt/meeting-bot, so the image never needs rebuilding when code changes.
# The Chrome profile is bind-mounted at ~/.meeting-bot/chrome-profile, which
# keeps the path capture.py and first_time_login.sh already expect.
RUN mkdir -p /app /opt/meeting-bot /root/.meeting-bot/chrome-profile
WORKDIR /app

# Sanity check at build time: a broken Chrome install should fail the build,
# not the first real meeting.
RUN google-chrome-stable --version && ffmpeg -version | head -n 1

CMD ["/bin/bash"]
