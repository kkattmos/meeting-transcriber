[Unit]
Description=Meeting bot remote trigger server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/meeting-bot.env
ExecStart=/usr/bin/python3 /opt/meeting-bot/trigger_server.py
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
