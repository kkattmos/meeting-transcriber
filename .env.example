# meeting-transcripter .env template
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# The `source_env.sh` loader (in this same directory) reads `.env` and
# exports every key=value line into the calling shell's environment.
# Every entry script (transcribe.sh, summarize.py, pipeline.sh) sources it
# at startup, so a single file covers every stage.
#
# Conventions used here:
#   - Lines beginning with `#` are comments and are skipped.
#   - Blank lines are skipped.
#   - Surrounding single or double quotes are stripped from values.
#   - Inline `# comments` after a value are NOT supported (keep values
#     on their own line). This matches the standard `docker run --env-file`
#     parser and avoids ambiguity.
#
# Anything not set here can still be exported in your shell / set in
# /etc/meeting-bot.env / passed via systemd EnvironmentFile — `.env` is
# just a convenience for the common case.

# ───────────────────────────────────────────────────────────────────────
# AI summary — backend selection
# ───────────────────────────────────────────────────────────────────────
# One of: gemini (default), anthropic, nvidia_nim, ollama, fallback.
# `fallback` walks SUMMARY_FALLBACK_CHAIN below in order until one
# succeeds; first success wins. Set SUMMARY_BACKEND=fallback if you want
# automatic failover instead of a single backend.
SUMMARY_BACKEND=fallback

# Only used when SUMMARY_BACKEND=fallback. Comma-separated list of
# backends to try, in order. Available names: gemini, fcc (= anthropic),
# anthropic, nvidia_nim, ollama. Use `disabled` to short-circuit a slot
# without editing this file.
SUMMARY_FALLBACK_CHAIN=gemini,fcc,nvidia_nim

# ───────────────────────────────────────────────────────────────────────
# FCC Claude (Anthropic SDK) — secondary backend (set SUMMARY_BACKEND=anthropic
# or include it in SUMMARY_FALLBACK_CHAIN to use it)
# ───────────────────────────────────────────────────────────────────────
# Base URL of the FCC proxy. Uncomment to override the default
# https://api.anthropic.com (the real Anthropic API).
# ANTHROPIC_BASE_URL=https://your-fcc-host.example.com
ANTHROPIC_API_KEY=
# Model name exposed by FCC. Default is the current Sonnet; change if your
# proxy exposes a different model.
SUMMARY_MODEL=claude-sonnet-4-5

# ───────────────────────────────────────────────────────────────────────
# NVIDIA NIM (OpenAI-compatible)
# ───────────────────────────────────────────────────────────────────────
NVIDIA_NIM_API_KEY=
# Override only if you self-host NIM or want a non-default endpoint.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Pick the model you want. Default is Llama 3.1 70B; NIM also offers
# Llama 3.1 405B, Nemotron, Mistral, etc.
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# ───────────────────────────────────────────────────────────────────────
# Google Gemini — default backend (SUMMARY_BACKEND=gemini above)
# ───────────────────────────────────────────────────────────────────────
# Either GOOGLE_API_KEY or GEMINI_API_KEY is fine; the client checks
# GOOGLE_API_KEY first.
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Default: gemini-3.6-flash (fast + cheap). For better quality on long
# videos use a -pro model.
#
# Pin a real version, not the "gemini-flash-latest" alias: as of 2026-09 that
# alias resolves to the newest flash model, which returns 503 "high demand" on
# most calls. And do check this value if summaries start failing — Google
# retires model names, and gemini-2.5-flash (the previous default here) now
# 404s with "no longer available to new users", which takes down the whole
# fallback chain if no other backend has a key.
GEMINI_MODEL=gemini-3.6-flash

# ───────────────────────────────────────────────────────────────────────
# Ollama (local, optional)
# ───────────────────────────────────────────────────────────────────────
# Only needed if you actually run Ollama on the VM. Leave blank otherwise.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava:13b

# ───────────────────────────────────────────────────────────────────────
# Transcribe step
# ───────────────────────────────────────────────────────────────────────
# Default routing for the local-file path is now AssemblyAI (see below).
# YouTube URLs always go to youtube-transcript.io regardless of this value.
# Override per-run with `TRANSCRIBE_BACKEND=assemblyai` (default) or
# `=youtube_transcript` (only meaningful on YouTube URLs).
TRANSCRIBE_BACKEND=assemblyai
# AssemblyAI language code for local recordings. th (Thai, default), en,
# auto, or any ISO-639-1 code AssemblyAI recognises.
# Ignored on the YouTube-API path because captions come pre-transcribed.
ASSEMBLYAI_LANGUAGE=th

# ───────────────────────────────────────────────────────────────────────
# Frame extraction (used by summarize step)
# ───────────────────────────────────────────────────────────────────────
# ffmpeg scene-change threshold. Lower = more frames. Default 0.3.
SCENE_THRESHOLD=0.3
# Periodic safety-net frame interval in seconds. Set to 0 to disable.
# Default 30. Use 10 for aggressive sampling, 300 for slides-only.
FRAME_PERIOD_SECONDS=30

# ───────────────────────────────────────────────────────────────────────
# Recording cap (Option 1)
# ───────────────────────────────────────────────────────────────────────
# Backstop wall-clock cap, in minutes. Default is 4h (240). Override per
# run with `MAX_MEETING_MINUTES=N ./pipeline.sh ...`.
MAX_MEETING_MINUTES=240
# Idle auto-leave: leave when participant count is 1 (only the bot) or 2
# (only the bot + one other person) for this many minutes. Catches test
# calls where the existing mass-exit rule doesn't fire (peak=2, 30% is 0).
# Set to 0 to disable. Per-run override: `IDLE_LEAVE_MINUTES=N`.
IDLE_LEAVE_MINUTES=5

# ───────────────────────────────────────────────────────────────────────
# AssemblyAI (local-file transcription, Stage 2)
# ───────────────────────────────────────────────────────────────────────
# Single API key from https://www.assemblyai.com. Required when
# transcribing a local recording (Stage 2 takes the MP4 from Stage 1 and
# uploads it directly). Ignored on the YouTube path, which still uses
# youtube-transcript.io.
ASSEMBLYAI_API_KEY=
# Optional: pin a specific speech model as the leading entry in the
# AssemblyAI SDK's ordered fallback list (default client behaviour: SDK's
# own chain of ["universal-3-5-pro", "universal-2"]). Setting this env var
# overrides the leading entry; "universal-2" stays as the safety net.
# See https://www.assemblyai.com/docs for current model names.
# ASSEMBLYAI_MODEL=universal-2

# ───────────────────────────────────────────────────────────────────────
# YouTube captions API (multi-account round-robin)
# ───────────────────────────────────────────────────────────────────────
# The list of API tokens lives in a separate JSON file (one token per
# account) — JSON handles the array cleanly. Override the path here only
# if you don't want the default /opt/meeting-bot/secrets/ location.
# YT_TRANSCRIPT_KEYS_FILE=/opt/meeting-bot/secrets/youtube_transcript_keys.json

# ---------------------------------------------------------------------------
# Transient-failure handling (503 "server is busy", 429, 5xx)
# ---------------------------------------------------------------------------
# Every backend call retries these with exponential backoff and full jitter,
# honoring Retry-After when the server sends a sane one. Only once a backend
# exhausts its retries does the fallback chain advance to the next entry.
# 400/401/403/404/422 never retry - a bad key fails the same way forever, and
# retrying just delays the fallback to a backend that would have worked.
SUMMARY_MAX_RETRIES=5
SUMMARY_RETRY_BASE_SECONDS=2.0
SUMMARY_RETRY_MAX_SECONDS=60.0

# ---------------------------------------------------------------------------
# Long transcripts: chunk, summarize in parallel, then merge
# ---------------------------------------------------------------------------
# Above SUMMARY_CHUNK_CHARS the transcript is split into chunks that are
# summarized concurrently and then merged by one final call. Chunking uses the
# .srt beside the .txt when present, so each chunk carries the frames that were
# on screen while those words were spoken. Set SUMMARY_CHUNK_CHARS=0 to always
# summarize in a single call.
SUMMARY_CHUNK_CHARS=24000
SUMMARY_CHUNK_OVERLAP=800
# Kept low on purpose: every chunk carries images, and a dozen simultaneous
# multi-megabyte requests is a good way to earn the 429s you then sit out.
SUMMARY_MAX_PARALLEL=3

# Document wrapper: auto (wrap lecture-*/tutorial-* output in the course-note
# template), always, or never.
SUMMARY_DOC_FORMAT=auto

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# How many inputs to process at once. Same as --jobs. On a 4-vCPU box 2-3 is
# sensible; frame extraction is the CPU-hungry part.
PIPELINE_JOBS=2

# Where everything is written. Also the path the recorder container mounts.
MEETING_BOT_ROOT=/opt/meeting-bot

# Container image for the browser stages (built by setup.sh).
RECORDER_IMAGE=meeting-bot-recorder:latest

# ---------------------------------------------------------------------------
# Cross-session queue (several ./pipeline.sh sessions at once)
# ---------------------------------------------------------------------------
# --jobs only limits concurrency WITHIN one ./pipeline.sh invocation. Run the
# script in three terminals (or trigger it three times from your phone) and you
# get three independent sets of stages hitting the same CPUs and the same
# rate-limited APIs. These limits are the machine-wide throttle those separate
# sessions coordinate through: whoever asks first runs first, the rest wait
# their turn and print how many are ahead.
#
# EVERY COMPONENT IS UNLIMITED UNLESS YOU SET ITS VARIABLE. With all of these
# commented out, nothing is throttled and no queue files are even created.
#
# Inspect and unstick:
#   python3 lib/slotqueue.py status
#   python3 lib/slotqueue.py reset --component transcribe
#
# QUEUE_SLOTS_DEFAULT=1          # fallback for any component below that's unset
# QUEUE_SLOTS_TRANSCRIBE=1       # one transcription at a time, box-wide
# QUEUE_SLOTS_FRAMES=1           # one ffmpeg frame extraction at a time (CPU-bound)
# QUEUE_SLOTS_SUMMARIZE=2        # two summaries in flight
# QUEUE_SLOTS_FETCH_VIDEO=1      # one yt-dlp download at a time

# CAREFUL with this one. Recording is the only time-sensitive stage: if two
# meetings overlap and there is one record slot, the second meeting is not
# delayed, it is MISSED - you cannot go back and record it later. Leave it
# unset unless your meetings never overlap.
# QUEUE_SLOTS_RECORD=1

# How often a waiting session re-checks for a free slot.
# QUEUE_POLL_SECONDS=2
# Give up after this many seconds of waiting (0 = wait forever, the default).
# A timed-out stage fails cleanly and the run stays resumable.
# QUEUE_WAIT_TIMEOUT_SECONDS=0
