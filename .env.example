# meeting-transcriber — copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env
# Every setting below is explained in README.md ("Configuration").

# ── Output directories (all five are required, all independent) ──────────
RECORDINGS_DIR=/opt/meeting-bot/recordings
TRANSCRIPTS_DIR=/opt/meeting-bot/transcripts
FRAMES_DIR=/opt/meeting-bot/frames
SUMMARIES_DIR=/opt/meeting-bot/summaries
PDF_DIR=/opt/meeting-bot/pdf
MEETING_BOT_ROOT=/opt/meeting-bot
CHROME_PROFILE_DIR=/opt/meeting-bot/chrome-profile

# ── Summarizer ───────────────────────────────────────────────────────────
SUMMARY_BACKEND=fallback
SUMMARY_FALLBACK_CHAIN=anthropic,gemini
SUMMARY_PROMPT=lecture-claude
SUMMARY_DOC_FORMAT=auto
SUMMARY_MAX_TOKENS=16000

# ── Anthropic Claude (default backend; one key) ───────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SUMMARY_EFFORT=high
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Google Gemini (fallback backend; up to 3 keys, round-robin) ───────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.6-flash

# ── AssemblyAI (local-file transcription; up to 3 keys, round-robin) ──────
ASSEMBLYAI_API_KEY_1=
ASSEMBLYAI_API_KEY_2=
ASSEMBLYAI_API_KEY_3=
ASSEMBLYAI_LANGUAGE=th
# ASSEMBLYAI_MODEL=universal-2

# ── youtube-transcript.io (YouTube captions; up to 10 keys, round-robin) ──
YT_TRANSCRIPT_KEY_1=
YT_TRANSCRIPT_KEY_2=
YT_TRANSCRIPT_KEY_3=
YT_TRANSCRIPT_KEY_4=
YT_TRANSCRIPT_KEY_5=
YT_TRANSCRIPT_KEY_6=
YT_TRANSCRIPT_KEY_7=
YT_TRANSCRIPT_KEY_8=
YT_TRANSCRIPT_KEY_9=
YT_TRANSCRIPT_KEY_10=

# ── Transcribe ───────────────────────────────────────────────────────────
TRANSCRIBE_BACKEND=assemblyai

# ── PDF export ───────────────────────────────────────────────────────────
SUMMARY_WRITE_PDF=1
SUMMARY_WRITE_MARKDOWN=1
PDF_FRAME_CROP=slide
PDF_FRAME_MAX_WIDTH=1280
PDF_PAGE_SIZE=A4
PDF_FONT_FAMILY=Noto Sans Thai, Noto Sans, DejaVu Sans, sans-serif

# ── Slides / reference resources ─────────────────────────────────────────
# RESOURCES=
RESOURCE_MAX_CHARS=40000
RESOURCE_MAX_FILE_MB=25
RESOURCE_SLIDE_IMAGES=1
RESOURCE_CACHE_DIR=/opt/meeting-bot/resources
# GITHUB_TOKEN=

# ── Frame extraction ─────────────────────────────────────────────────────
SCENE_THRESHOLD=0.3
FRAME_PERIOD_SECONDS=30

# ── Recording ────────────────────────────────────────────────────────────
MAX_MEETING_MINUTES=240
IDLE_LEAVE_MINUTES=5
RECORD_GEOMETRY=1920x1080
RECORD_FRAMERATE=15
MEETING_BOT_DISPLAY_NAME=Meeting Bot

# ── Transient-failure handling ───────────────────────────────────────────
SUMMARY_MAX_RETRIES=5
SUMMARY_RETRY_BASE_SECONDS=2.0
SUMMARY_RETRY_MAX_SECONDS=60.0

# ── Long transcripts ─────────────────────────────────────────────────────
SUMMARY_CHUNK_CHARS=24000
SUMMARY_CHUNK_OVERLAP=800
SUMMARY_MAX_PARALLEL=3

# ── Pipeline ─────────────────────────────────────────────────────────────
PIPELINE_JOBS=2

# ── Cross-session queue (unset = unlimited) ──────────────────────────────
# QUEUE_SLOTS_DEFAULT=1
# QUEUE_SLOTS_TRANSCRIBE=1
# QUEUE_SLOTS_FRAMES=1
# QUEUE_SLOTS_SUMMARIZE=2
# QUEUE_SLOTS_FETCH_VIDEO=1
# QUEUE_SLOTS_RECORD=1
# QUEUE_POLL_SECONDS=2
# QUEUE_WAIT_TIMEOUT_SECONDS=0
